<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Base Gradient Layer -->
    <item>
        <shape>
            <gradient
                android:angle="270"
                android:startColor="#92B7D3"
                android:centerColor="#BDB19E"
                android:endColor="#C98C70"
                android:type="linear" />
        </shape>
    </item>

    <!-- Soft Overlay -->
    <item>
        <shape>
            <gradient
                android:angle="90"
                android:startColor="#33FFFFFF"
                android:endColor="#00FFFFFF"
                android:type="linear" />
        </shape>
    </item>
</layer-list>
