<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    tools:context=".LocationPickerActivity">

    <!-- OSM MapView -->
    <org.osmdroid.views.MapView
        android:id="@+id/osmMapView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clickable="true"
        android:contentDescription="@string/app_name" />

    <!-- Floating Back Button -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fabBack"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        android:contentDescription="Back"
        app:srcCompat="@drawable/ic_back"
        app:backgroundTint="@color/colorPrimary"
        app:tint="?attr/colorOnSurface"
        app:layout_anchorGravity="top|start"
        android:layout_gravity="top|start" />

    <!-- Center Map Button -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fabCenter"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="32dp"
        android:layout_marginEnd="16dp"
        android:src="@drawable/ic_center_map"
        android:contentDescription="Center Map"
        android:layout_gravity="bottom|end" />

    <!-- Zoom In Button -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fabZoomIn"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="100dp"
        android:layout_marginEnd="16dp"
        android:src="@drawable/ic_zoom_in"
        android:backgroundTint="?attr/colorSurface"
        android:contentDescription="Zoom In"
        android:layout_gravity="bottom|end" />

    <!-- Zoom Out Button -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fabZoomOut"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="170dp"
        android:layout_marginEnd="16dp"
        android:src="@drawable/ic_zoom_out"
        android:contentDescription="Zoom Out"
        android:backgroundTint="?attr/colorSurface"
        android:layout_gravity="bottom|end" />

    <!-- Confirm Location Button as a proper Material Button inside a Card -->
    <androidx.cardview.widget.CardView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        app:cardCornerRadius="16dp"
        app:cardElevation="4dp"
        android:backgroundTint="@color/teal_700"
        app:layout_anchorGravity="bottom|center"
        android:layout_gravity="bottom|center">

        <TextView
            android:id="@+id/btnConfirmLocation"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Confirm"
            android:textColor="?attr/colorOnSurface"
            android:textSize="16sp"
            android:padding="12dp"
            android:textStyle="bold" />
    </androidx.cardview.widget.CardView>


    <!-- Optional Route Info Card -->
    <androidx.cardview.widget.CardView
        android:id="@+id/infoCard"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        app:cardCornerRadius="16dp"
        app:cardElevation="4dp"
        android:backgroundTint="@color/colorPrimary"
        app:layout_anchorGravity="top|end"
        android:layout_gravity="top|end">

        <TextView
            android:id="@+id/tvRouteInfo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Location"
            android:textColor="?attr/colorOnSurface"
            android:textSize="16sp"
            android:padding="12dp"
            android:textStyle="bold" />
    </androidx.cardview.widget.CardView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
