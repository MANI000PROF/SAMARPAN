<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/menuLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface"
    android:padding="24dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:id="@+id/appName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Samarpan"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="@color/colorPrimary" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Version 1.0.0"
            android:textColor="?attr/colorOnSurface"
            android:layout_marginTop="4dp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="16dp"
            android:background="?attr/colorOutline" />

        <TextView
            android:id="@+id/myContributionsRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="My Contributions"
            android:textSize="16sp"
            android:layout_marginTop="16dp"
            android:padding="12dp"
            android:background="@drawable/bg_menu_item"
            android:textColor="?attr/colorOnSurface" />

        <TextView
            android:id="@+id/savedLocationsRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Saved Locations"
            android:textSize="16sp"
            android:layout_marginTop="8dp"
            android:padding="12dp"
            android:background="@drawable/bg_menu_item"
            android:textColor="?attr/colorOnSurface" />

        <TextView
            android:id="@+id/rewardsRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Rewards &amp; Recognition"
            android:textSize="16sp"
            android:layout_marginTop="8dp"
            android:padding="12dp"
            android:background="@drawable/bg_menu_item"
            android:textColor="?attr/colorOnSurface" />

        <TextView
            android:id="@+id/guidelinesRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Community Guidelines"
            android:textSize="16sp"
            android:layout_marginTop="8dp"
            android:padding="12dp"
            android:background="@drawable/bg_menu_item"
            android:textColor="?attr/colorOnSurface" />

        <TextView
            android:id="@+id/shareRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Share App"
            android:textSize="16sp"
            android:layout_marginTop="8dp"
            android:padding="12dp"
            android:background="@drawable/bg_menu_item"
            android:textColor="?attr/colorOnSurface" />

        <TextView
            android:id="@+id/contactRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Contact Us"
            android:textSize="16sp"
            android:layout_marginTop="8dp"
            android:padding="12dp"
            android:background="@drawable/bg_menu_item"
            android:textColor="?attr/colorOnSurface" />

        <LinearLayout
            android:layout_marginTop="8dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <com.airbnb.lottie.LottieAnimationView
                android:id="@+id/chatbotAnimation"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:layout_gravity="start"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="8dp"
                android:layout_marginStart="4dp"
                app:lottie_rawRes="@raw/ai_assistant"
                app:lottie_loop="true"
                app:lottie_autoPlay="true" />

            <TextView
                android:id="@+id/chatbotRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Ask SAVI"
                android:textSize="16sp"
                android:padding="12dp"
                android:background="@drawable/bg_menu_item"
                android:textColor="?attr/colorOnSurface" />
        </LinearLayout>

        <LinearLayout
            android:layout_marginTop="8dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <ImageView
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:src="@drawable/icon_logout"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="8dp"
                android:layout_marginStart="4dp"
                android:layout_gravity="start|bottom"
                app:tint="?attr/colorOnSurface" />

            <TextView
                android:id="@+id/logoutOption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Logout"
                android:drawablePadding="12dp"
                android:textSize="16sp"
                android:textStyle="bold"
                android:layout_marginTop="24dp"
                android:padding="12dp"
                android:background="?attr/selectableItemBackground"
                android:textColor="?attr/colorError" />
    </LinearLayout>
    </LinearLayout>
</ScrollView>
