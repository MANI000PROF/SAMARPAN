<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/animated_gradient"
    tools:context=".IntroActivity">

    <!-- Heart appears first -->
    <ImageView
        android:id="@+id/logoHeart"
        android:layout_width="200dp"
        android:layout_height="150dp"
        android:layout_marginTop="108dp"
        android:scaleType="fitCenter"
        android:src="@drawable/transparent_logo_heart"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Hand appears below heart -->
    <ImageView
        android:id="@+id/logoHand"
        android:layout_width="350dp"
        android:layout_height="200dp"
        android:layout_marginTop="0dp"
        android:scaleType="fitCenter"
        android:src="@drawable/transparent_logo_hand"
        app:layout_constraintTop_toBottomOf="@+id/logoHeart"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Tagline under hand -->
    <TextView
        android:id="@+id/tagLine"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:fontFamily="cursive"
        android:gravity="center"
        android:text=""
        android:textColor="?attr/colorOnSurface"
        android:textSize="24sp"
        android:textStyle="bold"
        app:layout_constraintTop_toBottomOf="@+id/logoHand"
        app:layout_constraintStart_toStartOf="@+id/logoHand"
        app:layout_constraintEnd_toEndOf="@+id/logoHand" />

</androidx.constraintlayout.widget.ConstraintLayout>
